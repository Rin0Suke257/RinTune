{
  "name": "rmg",
  "version": "2.1.0",
  "description": "RinTune Studio - LMMS Random Music Generator Standalone App by Rin0suke257",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.rmg.musicgenerator",
    "productName": "RinTune Studio",
    "directories": {
      "output": "out"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/rmg_icon_512.png"
    },
    "files": [
      "**/*",
      "!dist/*"
    ]
  },
  "keywords": [
    "lmms",
    "music",
    "generator",
    "touhou",
    "midi"
  ],
  "author": "Rin0suke257",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^24.13.3"
  }
}
